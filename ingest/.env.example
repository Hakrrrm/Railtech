# Copy to .env (gitignored) and fill in. Never commit real credentials.

# Broker the bridge subscribes to. Use mqtts:// for a TLS broker (Stage 7+).
MQTT_URL=mqtt://test.mosquitto.org:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Supabase project. Service-role key ONLY -- this bridge is the one place
# it's allowed to live; the device never holds any Supabase credential.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Where malformed/rejected events are appended, one JSON object per line.
DEAD_LETTER_PATH=./dead_letter.ndjson
