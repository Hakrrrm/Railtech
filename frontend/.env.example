# ==========================================
# FRONTEND (Vite / React)
# ==========================================
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here

# Keep this enabled for a deterministic OCR fallback when the Supabase Edge
# Function is not deployed or has no OCR provider key. Set false to require
# the live OCR function and surface any provider error to the technician.
VITE_TECHNICIAN_DEMO_OCR=true

# Never place sb_secret_ or service-role credentials in this browser file.
# MQTT and service-role settings belong in ingest/.env.
